# Copy this file to .env and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). Without them the site still
# works, using the products in src/data/products.json, but the admin panel is off.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
